        "text": {
          "text": "O guardião caiu diante da sua runa. Os novos padrões gravados agora ressoam pelo continente.",
          "translations": {
            "pt_BR": "O guardião caiu diante da sua runa. Os novos padrões gravados agora ressoam pelo continente."
