layout_mode = 2
theme_override_font_sizes/font_size = 17
metadata/font_role = "body"
metadata/text_role = "text.primary"

[node name="ScalingLines" type="VBoxContainer" parent="CardDetailsScroll/CardDetailContent/Facts"]
unique_name_in_owner = true
layout_mode = 2
