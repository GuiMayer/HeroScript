[gd_scene format=3]
[ext_resource type="Script" path="res://scripts/ui/combat_mvp_view.gd" id="Script"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/combat_header.tscn" id="Header"]
[ext_resource type="PackedScene" path="res://scenes/ui/combat_composition.tscn" id="Composition"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/card_zone_controls.tscn" id="Piles"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/action_preview.tscn" id="Preview"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/combat_candidates.tscn" id="Candidates"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/combat_button.tscn" id="Button"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/combat/combat_attributes_drawer.tscn" id="Attributes"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/card_hand.tscn" id="Hand"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/turn_controls.tscn" id="Turn"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/battlefield.tscn" id="Field"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/floating_hud.tscn" id="Floating"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/combat_feedback.tscn" id="Feedback"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/mvp_combat_header.tscn" id="MvpHeader"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/mvp_arena.tscn" id="Arena"]
[node name="CombatView" type="VBoxContainer"]
size_flags_vertical = 3
theme_override_constants/separation = 12
script = ExtResource("Script")
composition_scene = ExtResource("Arena")
[node name="CombatFeedback" parent="." instance=ExtResource("Feedback")]
[node name="CombatHeader" parent="." instance=ExtResource("MvpHeader")]
layout_mode = 2
[node name="InscriptionStrip" type="HBoxContainer" parent="."]
visible = false
layout_mode = 2
custom_minimum_size = Vector2(0, 28)
metadata/review_todo = "Show published equipped inscriptions only; review projection."
[node name="CombatBody" parent="." instance=ExtResource("Arena")]
layout_mode = 2
[node name="Battlefield" parent="CombatBody/CombatGameplay" instance=ExtResource("Field")]
[node name="CombatBottomHUD" type="HBoxContainer" parent="CombatBody/CombatGameplay"]
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
grow_vertical = 0
mouse_filter = 2
theme_override_constants/separation = 20
[node name="Balance" type="Control" parent="CombatBody/CombatGameplay/CombatBottomHUD"]
layout_mode = 2
mouse_filter = 2
[node name="HandSection" type="VBoxContainer" parent="CombatBody/CombatGameplay/CombatBottomHUD"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 8
theme_override_constants/separation = 10
[node name="Hint" type="Label" parent="CombatBody/CombatGameplay/CombatBottomHUD/HandSection"]
visible = false
layout_mode = 2
[node name="Energy" type="Label" parent="CombatBody/CombatGameplay/CombatBottomHUD/HandSection"]
layout_mode = 2
horizontal_alignment = 1
theme_override_font_sizes/font_size = 22
[node name="CardHandView" parent="CombatBody/CombatGameplay/CombatBottomHUD/HandSection" instance=ExtResource("Hand")]
layout_mode = 2
[node name="TurnControls" parent="CombatBody/CombatGameplay/CombatBottomHUD" instance=ExtResource("Turn")]
layout_mode = 2
size_flags_vertical = 8
theme_override_constants/separation = 10
[node name="EndTurnGap" type="Control" parent="CombatBody/CombatGameplay/CombatBottomHUD/TurnControls"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
mouse_filter = 2
[node name="FloatingCombatHUD" parent="." instance=ExtResource("Floating")]
[node name="OverlayDefinitions" type="Control" parent="."]
visible = false
[node name="PileControls" parent="OverlayDefinitions" instance=ExtResource("Piles")]
[node name="RightPileControls" parent="OverlayDefinitions" instance=ExtResource("Piles")]
[node name="ActionPreviewView" parent="OverlayDefinitions" instance=ExtResource("Preview")]
[node name="CandidatePanel" parent="OverlayDefinitions" instance=ExtResource("Candidates")]
[node name="Reconnect" parent="OverlayDefinitions" instance=ExtResource("Button")]
[node name="CombatAttributesDrawer" parent="OverlayDefinitions" instance=ExtResource("Attributes")]
[node name="CombatLog" type="AcceptDialog" parent="."]
size = Vector2i(700, 480)
[node name="Scroll" type="ScrollContainer" parent="CombatLog"]
anchor_right = 1.0
anchor_bottom = 1.0
[node name="Events" type="RichTextLabel" parent="CombatLog/Scroll"]
custom_minimum_size = Vector2(640, 400)
size_flags_horizontal = 3
fit_content = true
scroll_active = false

[editable path="CombatBody"]
