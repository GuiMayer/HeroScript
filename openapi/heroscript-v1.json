{
  "openapi": "3.0.4",
  "info": {
    "title": "HeroScript API",
    "version": "v1",
    "description": "Contrato público para runs determinísticas, conteúdo imutável e replay verificável."
  },
  "servers": [
    { "url": "http://localhost:5260", "description": "Desenvolvimento local" }
  ],
  "tags": [
    { "name": "System" },
    { "name": "Runs" },
    { "name": "Combats" },
    { "name": "Content" }
  ],
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "tags": ["System"],
        "operationId": "getLiveness",
        "x-heroscript-stability": "stable",
        "responses": { "200": { "description": "Process is alive" } }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "tags": ["System"],
        "operationId": "getCapabilities",
        "x-heroscript-stability": "stable",
        "responses": { "200": { "description": "Published capability list" } }
      }
    },
    "/api/v1/runs": {
      "post": {
        "tags": ["Runs"],
        "operationId": "startRun",
        "x-heroscript-stability": "stable",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunStartRequest" } } }
        },
        "responses": {
          "200": { "description": "Run created deterministically" },
          "400": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/runs/{runId}": {
      "get": {
        "tags": ["Runs"],
        "operationId": "getRun",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": {
          "200": { "description": "Immutable run read model" },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/runs/{runId}/commands": {
      "post": {
        "tags": ["Runs"],
        "operationId": "executeRunCommand",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommandEnvelope" } } }
        },
        "responses": {
          "200": { "description": "Idempotent command result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommandResult" } } } },
          "409": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/combats/{combatId}": {
      "get": {
        "tags": ["Combats"],
        "operationId": "getCombat",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/CombatId" }],
        "responses": { "200": { "description": "Combat read model" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/combats/{combatId}/commands": {
      "post": {
        "tags": ["Combats"],
        "operationId": "executeCombatCommand",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/CombatId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommandEnvelope" } } }
        },
        "responses": {
          "200": { "description": "Idempotent command result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommandResult" } } } },
          "409": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/content/revisions": {
      "get": {
        "tags": ["Content"],
        "operationId": "listContentRevisions",
        "x-heroscript-stability": "stable",
        "responses": { "200": { "description": "Immutable content revision catalog" } }
      }
    }
  },
  "components": {
    "parameters": {
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "CombatId": { "name": "combatId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "responses": {
      "Problem": {
        "description": "RFC 9457 problem response",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      }
    },
    "schemas": {
      "RunStartRequest": {
        "type": "object",
        "required": ["configName", "runDefinitionId", "playerEntityId"],
        "properties": {
          "configName": { "type": "string" },
          "runDefinitionId": { "type": "string" },
          "playerEntityId": { "type": "string" },
          "seed": { "type": "integer", "format": "uint64" },
          "contentRevision": { "type": "string" }
        }
      },
      "CommandEnvelope": {
        "type": "object",
        "required": ["commandId", "type", "payload"],
        "properties": {
          "commandId": { "type": "string", "format": "uuid", "description": "Idempotency key" },
          "expectedSequence": { "type": "integer", "minimum": 0 },
          "expectedStep": { "type": "integer", "format": "uint64" },
          "type": { "type": "string" },
          "payload": { "type": "object", "additionalProperties": true }
        }
      },
      "CommandResult": {
        "type": "object",
        "required": ["commandId", "step", "previousStateHash", "stateHash", "state", "events"],
        "properties": {
          "commandId": { "type": "string", "format": "uuid" },
          "sequence": { "type": "integer" },
          "step": { "type": "integer", "format": "uint64" },
          "previousStateHash": { "type": "string" },
          "stateHash": { "type": "string" },
          "state": { "type": "object", "additionalProperties": true },
          "events": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "format": "uri-reference" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string", "format": "uri-reference" },
          "code": { "type": "string", "description": "Stable machine-readable HeroScript error code" },
          "correlationId": { "type": "string", "description": "Request correlation identifier" },
          "currentSequence": { "type": "integer", "description": "Authoritative sequence when a command conflicts" },
          "currentStep": { "type": "integer", "format": "uint64", "description": "Authoritative deterministic step when a command conflicts" }
        }
      }
    }
  }
}
