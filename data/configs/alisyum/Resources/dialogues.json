      {
        "nodeId": "node_0",
        "speaker": {
          "text": "Cobaia da Runa",
          "translations": {
            "pt_BR": "Cobaia da Runa"
          }
        },
        "text": {
          "text": "A pele cinza racha com veios de magma cada vez que sua respiração acelera. Os executores de Vidaria vieram recolher a cobaia — queime tudo antes que a runa consuma você.",
          "translations": {
            "pt_BR": "A pele cinza racha com veios de magma cada vez que sua respiração acelera. Os executores de Vidaria vieram recolher a cobaia — queime tudo antes que a runa consuma você."
          }
        },
        "choices": [
          {
            "choiceId": "continue",
            "interactionKind": "Continue",
            "once": true,
            "text": {
              "text": "Avançar",
              "translations": {
                "pt_BR": "Avançar"
              }
            },
            "setFlags": {
              "alisyum.pyro.started": "true"
            }
          }
        ]
      }
    ]
  },
  "alisyum_ending_pyro": {
    "dialogueId": "alisyum_ending_pyro",
    "title": {
      "text": "Cinzas do Arconte",
      "translations": {
        "pt_BR": "Cinzas do Arconte"
