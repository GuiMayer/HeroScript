{
  "table_combat": {
    "combatRulesId": "table_combat",
    "defaultPhaseSequenceId": "classic-style",
    "turnOrder": {
      "strategy": "Fixed",
      "recalculateAt": "CombatStart",
      "tieBreak": {
        "strategy": "StableActorId",
        "epoch": "Unspecified"
      }
    },
    "flow": {
      "automaticResolution": {
        "strategy": "ToNextPlayerInput",
        "maxAutomaticSteps": 100
      },
      "actionBudget": {
        "strategy": "ResourceLimited",
        "actionCosts": "Configured",
        "actorScope": "All",
        "resourceId": "t_energy",
        "consumingCommands": [
          "PLAY_CARD"
        ]
      },
      "ai": {
        "enabled": true,
        "autoEndAfterAction": false,
        "publishIntents": true,
        "decisionIds": [
          "g_t_choose_red",
          "g_t_choose_blue",
          "g_t_choose_green",
          "g_t_choose_yellow",
          "g_t_accept",
          "g_t_call",
          "g_t_catch",
          "g_play",
          "g_draw",
          "g_end"
        ],
        "intent": {
          "refresh": "RecomputeOnPublish",
          "whenInvalid": "Recompute"
        }
      },
      "resourceCycle": {
        "resourceId": "t_energy",
        "actorScope": "All",
        "startActivation": "Set",
        "amount": 1
      },
      "statusTiming": {
        "boundaries": [
          "StartActivation",
          "EndActivation"
        ],
        "ordering": "PriorityThenInstanceId"
      },
      "outcome": {
        "evaluationBoundary": "AfterCurrentAction",
        "tieBreak": "Draw",
        "participantVictory": {
          "ruleId": "empty-hand",
          "inputs": [
            {
              "variable": "myHand",
              "kind": "ZoneCount",
              "zones": [
                {
                  "zoneId": "hand",
                  "ownerScope": "Actor",
                  "actor": "Source"
                }
              ]
            }
          ],
          "condition": "t_empty",
          "tieBreak": "ActiveActorThenOrdinal"
        }
      },
      "encounterResolution": {
        "strategy": "ManualAck"
      },
      "animation": {
        "mode": "CompactWithSnapshotLookup"
      },
      "journal": {
        "granularity": "Full"
      },
      "reactions": {
        "strategy": "Disabled"
      },
      "activationSequence": {
        "strategy": "Circular",
        "circular": {
          "initialDirection": "Forward",
          "firstActor": "RunOwner",
          "roundPolicy": "Disabled",
          "allowSelfSuccessor": true
        }
      },
      "queries": [
        {
          "variable": "myHand",
          "kind": "ZoneCount",
          "zones": [
            {
              "zoneId": "hand",
              "ownerScope": "Actor",
              "actor": "Source"
            }
          ]
        },
        {
          "variable": "availableCards",
          "kind": "SumZoneCounts",
          "zones": [
            {
              "zoneId": "draw",
              "ownerScope": "RunOwner"
            },
            {
              "zoneId": "discard",
              "ownerScope": "RunOwner"
            }
          ]
        }
      ],
      "commandConditions": [
        {
          "ruleId": "draw.required",
          "commands": [
            "END_TURN",
            "PASS"
          ],
          "actorScope": "All",
          "inputs": [
            {
              "variable": "availableCards",
              "kind": "SumZoneCounts",
              "zones": [
                {
                  "zoneId": "draw",
                  "ownerScope": "RunOwner"
                },
                {
                  "zoneId": "discard",
                  "ownerScope": "RunOwner"
                }
              ]
            },
            {
              "variable": "drawAttempts",
              "kind": "ActivationCommandCount",
              "actionId": "t_draw"
            },
            {
              "variable": "hasCard",
              "kind": "HasBaseLegalCard"
            }
          ],
          "allowCondition": "t_can_end",
          "failureCode": "DRAW_REQUIRED",
          "messageKey": "draw.required"
        },
        {
          "ruleId": "choice.required",
          "commands": [
            "END_TURN",
            "PASS"
          ],
          "actorScope": "All",
          "inputs": [],
          "allowCondition": "1 - source.resources.t_choice.current",
          "failureCode": "CHOICE_REQUIRED",
          "messageKey": "choice.required"
        },
        {
          "ruleId": "debt.required",
          "commands": [
            "END_TURN",
            "PASS"
          ],
          "actorScope": "All",
          "inputs": [],
          "allowCondition": "t_no_debt",
          "failureCode": "DEBT_REQUIRED",
          "messageKey": "debt.required"
        },
        {
          "ruleId": "draw.once",
          "commands": [
            "POWER"
          ],
          "actorScope": "All",
          "inputs": [
            {
              "variable": "drawAttempts",
              "kind": "ActivationCommandCount",
              "actionId": "t_draw"
            }
          ],
          "allowCondition": "1 - drawAttempts",
          "failureCode": "DRAW_ONCE",
          "messageKey": "draw.once",
          "actionId": "t_draw"
        },
        {
          "ruleId": "draw.available",
          "commands": [
            "POWER"
          ],
          "actorScope": "All",
