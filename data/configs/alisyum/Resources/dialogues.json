      {
        "nodeId": "node_0",
        "speaker": {
          "text": "Crônica de Vidaria",
          "translations": {
            "pt_BR": "Crônica de Vidaria"
          }
        },
        "text": {
          "text": "O Arconte da Fornalha se desfez em escória. A runa em seu peito não obedece mais aos mestres de Vidaria — agora ela arde apenas sob a sua vontade.",
          "translations": {
            "pt_BR": "O Arconte da Fornalha se desfez em escória. A runa em seu peito não obedece mais aos mestres de Vidaria — agora ela arde apenas sob a sua vontade."
          }
        },
        "choices": [
          {
            "choiceId": "continue",
            "interactionKind": "Continue",
            "once": true,
            "text": {
              "text": "Encerrar Capítulo",
              "translations": {
                "pt_BR": "Encerrar Capítulo"
              }
            },
            "setFlags": {
              "alisyum.pyro.ended": "true"
            }
          }
        ]
      }
    ]
  },
  "alisyum_opening_servo": {
