{
  "statusEffects": [
    {
      "statusId": "STRENGTH",
      "displayName": "Strength",
      "description": "Increases damage dealt. Each stack adds 25% more damage.",
      "type": "BUFF",
      "isStackable": true,
      "maxStacks": 5,
      
      // Permanent duration (-1) - lasts until removed or combat ends
      "defaultDuration": -1,
      
      // refreshDuration: false - reapplying doesn't reset duration
      // (not relevant for permanent effects, but good practice to set)
      "refreshDuration": false,
      
      "behaviors": [
        {
          // PASSIVE timing: Always active, no trigger needed
          "timing": "PASSIVE",
          
          // STAT_MODIFIER: Modifies damage calculation
          "type": "STAT_MODIFIER",
          
          // modifierKey: Which stat to modify
          // Must match keys in DamageCalculator modifier system
          "modifierKey": "increased_damage_total",
          
          // formulaValue: Mathematical expression for the modifier
          // "stacks" is a variable representing current stack count
          // 3 stacks = 3 * 0.25 = 0.75 = +75% damage
          "formulaValue": "stacks * 0.25",
          "scalesWithStacks": true
        }
      ]
    },
    
    {
      "statusId": "DEXTERITY",
      "displayName": "Dexterity",
      "description": "Increases critical hit chance. Each stack adds 10% crit chance.",
      "type": "BUFF",
      "isStackable": true,
      
      // Lower max stacks (3) to prevent excessive crit chance
      // 3 stacks = 30% crit chance, which is significant but not broken
      "maxStacks": 3,
      "defaultDuration": -1,
      "refreshDuration": false,
      "behaviors": [
        {
          "timing": "PASSIVE",
          "type": "STAT_MODIFIER",
          
          // crit_chance modifier affects critical hit probability
          "modifierKey": "crit_chance",
          "formulaValue": "stacks * 0.10",
          "scalesWithStacks": true
        }
      ]
    },
    
    {
      "statusId": "REGENERATION",
      "displayName": "Regeneration",
      "description": "Restores health at the start of each turn. Stacks increase healing.",
      "type": "BUFF",
      "isStackable": true,
      "maxStacks": 5,
      
      // Temporary duration (3 turns)
      "defaultDuration": 3,
      "refreshDuration": true,
      "behaviors": [
        {
          // START_OF_TURN: Triggers at the beginning of the entity's turn
          // Healing happens before actions, so you can use the HP immediately
          "timing": "START_OF_TURN",
          
          // HEAL_OVER_TIME: Restores HP each turn
          "type": "HEAL_OVER_TIME",
          
          // Base healing per tick
          // 3 stacks = 15 HP per turn (5 * 3)
          "value": 5.0,
          "scalesWithStacks": true
        }
      ]
    },
    
    {
      "statusId": "SHIELD",
      "displayName": "Shield",
      "description": "Absorbs incoming damage. Each stack absorbs 10 damage before breaking.",
      "type": "BUFF",
      "isStackable": true,
      "maxStacks": 10,
      
      // Permanent - shield lasts until depleted or removed
      "defaultDuration": -1,
      "refreshDuration": false,
      "behaviors": [
        {
          // ON_DAMAGE_TAKEN: Triggers when entity takes damage
          "timing": "ON_DAMAGE_TAKEN",
          
          // ABSORB_DAMAGE: Reduces incoming damage and consumes stacks
          // When damage exceeds absorption, remaining damage goes through
          "type": "ABSORB_DAMAGE",
          
          // Each stack absorbs 10 damage
          // 5 stacks = 50 damage absorption total
          "value": 10.0,
          "scalesWithStacks": true
        }
      ]
    }
  ]
}
