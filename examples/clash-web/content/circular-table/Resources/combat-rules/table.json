                },
                {
                  "zoneId": "discard",
                  "ownerScope": "RunOwner"
                }
              ]
            }
          ],
          "allowCondition": "availableCards",
          "failureCode": "DRAW_AVAILABLE",
          "messageKey": "draw.available",
          "actionId": "t_draw"
        },
        {
          "ruleId": "draw.budget",
          "commands": [
            "POWER"
          ],
          "actorScope": "All",
          "inputs": [],
          "allowCondition": "source.resources.t_energy.current",
          "failureCode": "DRAW_BUDGET",
          "messageKey": "draw.budget",
          "actionId": "t_draw"
        },
        {
          "ruleId": "draw.no-debt",
          "commands": [
