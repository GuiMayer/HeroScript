[gd_scene load_steps=5 format=3]
[ext_resource type="Script" path="res://scripts/ui/card_details_panel.gd" id="script"]
[ext_resource type="Script" path="res://scripts/ui/card_effect_text.gd" id="rules"]
[sub_resource type="StyleBoxFlat" id="Surface"]
resource_local_to_scene = true
bg_color = Color(1,1,1,1)
content_margin_left = 14.0
content_margin_right = 14.0
content_margin_top = 12.0
content_margin_bottom = 12.0
border_width_left = 2
border_width_right = 2
border_width_top = 2
border_width_bottom = 2
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_left = 2
corner_radius_bottom_right = 2
[sub_resource type="StyleBoxFlat" id="EffectSurface"]
resource_local_to_scene = true
bg_color = Color(0.12549,0.129412,0.141176,1)
content_margin_left = 14.0
content_margin_right = 14.0
content_margin_top = 12.0
content_margin_bottom = 12.0
corner_radius_top_left = 1
corner_radius_top_right = 1
corner_radius_bottom_left = 1
corner_radius_bottom_right = 1

[node name="CardDetails" type="PanelContainer"]
script = ExtResource("script")
theme_override_styles/panel = SubResource("Surface")

[node name="CardDetailsScroll" type="ScrollContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
horizontal_scroll_mode = 0
size_flags_vertical = 3
focus_mode = 2
follow_focus = true

[node name="CardDetailContent" type="VBoxContainer" parent="CardDetailsScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Glossary" type="VBoxContainer" parent="CardDetailsScroll/CardDetailContent"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Facts" type="VBoxContainer" parent="CardDetailsScroll/CardDetailContent"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Classic" type="VBoxContainer" parent="CardDetailsScroll/CardDetailContent"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="ScalingHeading" type="Label" parent="CardDetailsScroll/CardDetailContent/Facts"]
