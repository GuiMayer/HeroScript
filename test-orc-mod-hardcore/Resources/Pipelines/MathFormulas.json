      "$op": "MERGE_DEEP",
      "$data": {
        "description": "Raiva hardcore - escala ainda mais agressiva",
        "params": {
          "BASE_MULTIPLIER": 2.0,
          "MAX_RAGE": 5.0
        }
      }
    }
  },
  "EXPONENTIAL_SCALING": {
