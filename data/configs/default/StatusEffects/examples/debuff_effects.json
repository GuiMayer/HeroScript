{
  "statusEffects": [
    {
      "statusId": "WEAKNESS",
      "displayName": "Weakness",
      "description": "Reduces damage dealt. Each stack reduces damage by 25%.",
      "type": "DEBUFF",
      "isStackable": true,
      
      // Lower max stacks (3) to prevent complete damage negation
      // 3 stacks = -75% damage, which is severe but not 100% reduction
      "maxStacks": 3,
      "defaultDuration": 3,
      "refreshDuration": true,
      
      "behaviors": [
        {
          "timing": "PASSIVE",
          "type": "STAT_MODIFIER",
          
          // Same modifier key as STRENGTH, but negative value
          // This means they directly counteract each other
          "modifierKey": "increased_damage_total",
          
          // Negative formula: reduces damage instead of increasing it
          // 2 stacks = 2 * -0.25 = -0.50 = -50% damage
          "formulaValue": "stacks * -0.25",
          "scalesWithStacks": true
        }
      ]
    },
    
    {
      "statusId": "VULNERABLE",
      "displayName": "Vulnerable",
      "description": "Increases damage taken. Each stack increases damage taken by 50%.",
      "type": "DEBUFF",
      "isStackable": true,
      "maxStacks": 3,
      
      // Shorter duration (2 turns) - very powerful effect
      // 1 stack = +50% damage taken is already significant
      "defaultDuration": 2,
      "refreshDuration": true,
      
      "behaviors": [
        {
          "timing": "PASSIVE",
          "type": "STAT_MODIFIER",
          
          // increased_damage_taken: Multiplies incoming damage
          // This is different from increased_damage_total (outgoing)
          "modifierKey": "increased_damage_taken",
          
          // Positive value because we're increasing damage taken
          // 2 stacks = 2 * 0.50 = 1.00 = +100% damage taken (double damage!)
          "formulaValue": "stacks * 0.50",
          "scalesWithStacks": true
        }
      ]
    },
    
    {
      "statusId": "FRAIL",
      "displayName": "Frail",
      "description": "Reduces block effectiveness. Each stack reduces block by 25%.",
      "type": "DEBUFF",
      "isStackable": true,
      "maxStacks": 3,
      "defaultDuration": 3,
      "refreshDuration": true,
      
      "behaviors": [
        {
          "timing": "PASSIVE",
          "type": "STAT_MODIFIER",
          
          // block_effectiveness: Reduces block gained from cards/abilities
          // If you would gain 10 block with 1 stack of Frail:
          // 10 * (1 + (-0.25)) = 10 * 0.75 = 7.5 block
          "modifierKey": "block_effectiveness",
          "formulaValue": "stacks * -0.25",
          "scalesWithStacks": true
        }
      ]
    },
    
    {
      "statusId": "STUNNED",
      "displayName": "Stunned",
      "description": "Cannot act. Skips turn entirely.",
      "type": "DEBUFF",
      
      // Not stackable - you're either stunned or not
      "isStackable": false,
      "maxStacks": 1,
      
      // Very short duration (1 turn) - losing a turn is extremely powerful
      "defaultDuration": 1,
      "refreshDuration": false,
      
      "behaviors": [
        {
          // START_OF_TURN: Checked before entity can act
          "timing": "START_OF_TURN",
          
          // SKIP_TURN: Prevents all actions for this turn
          // No value needed - binary effect
          "type": "SKIP_TURN"
        }
      ]
    },
    
    {
      "statusId": "SILENCED",
      "displayName": "Silenced",
      "description": "Cannot use powers or abilities. Basic attacks only.",
      "type": "DEBUFF",
      "isStackable": false,
      "maxStacks": 1,
      
      // Slightly longer duration (2 turns) than Stun
      // Less severe than Stun (can still basic attack)
      "defaultDuration": 2,
      "refreshDuration": false,
      
      "behaviors": [
        {
          "timing": "PASSIVE",
          
          // DISABLE_POWERS: Prevents using abilities/powers
          // Basic attacks still work - less severe than SKIP_TURN
          "type": "DISABLE_POWERS"
        }
      ]
    }
  ]
}
