{
  "buckets": [
    {
      "bucketId": "base_damage",
      "order": 1,
      "operations": [
        {
          "type": "ADD_FLAT",
          "source": "modifier:base_damage"
        }
      ]
    },
    {
      "bucketId": "attack_stat",
      "order": 2,
      "operations": [
        {
          "type": "MULTIPLY",
          "source": "formula:modifier:attack / 100"
        }
      ]
    },
    {
      "bucketId": "crit_roll",
      "order": 3,
      "operations": [
        {
          "type": "ROLL_CRIT_TIER",
          "source": "modifier:crit_chance",
          "parameters": {
            "multiplierSource": "modifier:crit_multiplier"
          }
        }
      ]
    },
    {
      "bucketId": "crit_multiplier",
      "order": 4,
      "filterConditions": [
        {
          "type": "METADATA_EXISTS",
          "parameter": "crit_tier"
        }
      ],
      "operations": [
        {
          "type": "MULTIPLY",
          "source": "modifier:crit_multiplier"
        }
      ]
    },
    {
      "bucketId": "defense_reduction",
      "order": 5,
      "operations": [
        {
          "type": "ADD_FLAT",
          "source": "formula:-1 * modifier:target_defense"
        }
      ]
    },
    {
      "bucketId": "minimum_damage",
      "order": 6,
      "operations": [
        {
          "type": "APPLY_FORMULA",
          "source": "max(current_damage, 1)"
        }
      ]
    }
  ]
}
