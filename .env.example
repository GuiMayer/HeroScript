# HeroScript API - Environment Configuration Template
# Copy this file to .env and fill in your values

# ==============================================
# REQUIRED: Admin API Key
# ==============================================
# Used for CRUD endpoints (POST/PUT/DELETE)
# Generate a strong key: openssl rand -hex 32
HERESCRIPT_ADMIN_KEY=your-secret-key-here

# ==============================================
# APPLICATION SETTINGS
# ==============================================
# Environment: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Production

# API port (internal container port is always 8080)
API_PORT=5260

# ==============================================
# CORS CONFIGURATION
# ==============================================
# Allowed origins (add your frontend domains)
ALLOWED_ORIGIN_0=http://localhost:3000
ALLOWED_ORIGIN_1=http://localhost:5173
# Add more origins as needed:
# ALLOWED_ORIGIN_2=https://yourgame.com
# ALLOWED_ORIGIN_3=https://dashboard.yourgame.com

# ==============================================
# PERSISTENCE (Optional - defaults are fine)
# ==============================================
# Persistence__EventStorePath=/app/data/events
# Persistence__RunStatePath=/app/data/runs
