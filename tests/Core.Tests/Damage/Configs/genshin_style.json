{
  "buckets": [
    {
      "bucketId": "base_damage",
      "order": 1,
      "operations": [
        {
          "type": "MULTIPLY",
          "source": "modifier:skill_multiplier"
        },
        {
          "type": "MULTIPLY",
          "source": "modifier:attack_stat"
        }
      ]
    },
    {
      "bucketId": "damage_bonus",
      "order": 2,
      "operations": [
        {
          "type": "MULTIPLY",
          "source": "formula:1 + (modifier:damage_bonus / 100)"
        }
      ]
    },
    {
      "bucketId": "elemental_bonus",
      "order": 3,
      "filterConditions": [
        {
          "type": "OR",
          "subConditions": [
            {
              "type": "TAG_PRESENT",
              "parameter": "pyro"
            },
            {
              "type": "TAG_PRESENT",
              "parameter": "hydro"
            },
            {
              "type": "TAG_PRESENT",
              "parameter": "electro"
            }
          ]
        }
      ],
      "operations": [
        {
          "type": "MULTIPLY",
          "source": "formula:1 + (modifier:elemental_bonus / 100)"
        }
      ]
    },
    {
      "bucketId": "crit_roll",
      "order": 4,
      "operations": [
        {
          "type": "ROLL_CRIT_TIER",
          "source": "modifier:crit_rate"
        }
      ]
    },
    {
      "bucketId": "crit_damage",
      "order": 5,
      "filterConditions": [
        {
          "type": "METADATA_EXISTS",
          "parameter": "crit_tier"
        }
      ],
      "operations": [
        {
          "type": "MULTIPLY",
          "source": "formula:1 + (modifier:crit_damage / 100)"
        }
      ]
    },
    {
      "bucketId": "defense",
      "order": 6,
      "operations": [
        {
          "type": "MULTIPLY",
          "source": "formula:(modifier:attacker_level + 100) / ((modifier:attacker_level + 100) + (modifier:target_level + 100) * (1 - modifier:defense_reduction / 100))"
        }
      ]
    },
    {
      "bucketId": "resistance",
      "order": 7,
      "operations": [
        {
          "type": "MULTIPLY",
          "source": "formula:1 - (modifier:target_resistance / 100)"
        }
      ]
    },
    {
      "bucketId": "reaction_bonus",
      "order": 8,
      "filterConditions": [
        {
          "type": "METADATA_EXISTS",
          "parameter": "reaction_type"
        }
      ],
      "operations": [
        {
          "type": "MULTIPLY",
          "source": "modifier:reaction_multiplier"
        }
      ]
    }
  ]
}
