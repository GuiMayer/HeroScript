{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:5173"
  ],
  "Admin": {
    "Enabled": false
  },
  "ToolAccess": {
    "Profile": "normal",
    "CustomCapabilities": []
  },
  "AllowConfigReload": false,
  "Persistence": {
    "OperationalTelemetryPath": "data/telemetry",
    "RunStatePath": "data/runs",
    "ContentStorePath": "data/content"
  }
}
