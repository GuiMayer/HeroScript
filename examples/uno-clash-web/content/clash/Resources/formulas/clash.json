      {
        "op": "ADD",
        "value": "1"
      },
      {
        "op": "ADD",
        "value": "params.source.resources.uno_draw2_pending.current"
      },
      {
        "op": "ADD",
        "value": "params.source.resources.uno_setup.current"
      },
      {
        "op": "MULTIPLY",
        "value": "params.source.resources.uno_energy.maximum"
      },
      {
        "op": "SUBTRACT",
        "value": "params.source.resources.uno_energy.current"
      },
      {
        "op": "ADD",
        "value": "1"
      }
    ],
    "params": {
      "duelAvailable": 0,
      "duelHasCard": 0,
      "source.resources.uno_draw_available.current": 0,
      "source.resources.uno_draw2_pending.current": 0,
      "source.resources.uno_setup.current": 0,
      "source.resources.uno_energy.maximum": 0,
      "source.resources.uno_energy.current": 0
