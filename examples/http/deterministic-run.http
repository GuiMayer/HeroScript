@baseUrl = http://localhost:5260
@runId = replace-with-run-id
@commandId = 54c0c99b-21b1-4e2f-a519-0de7fdf79ece
@creationCommandId = 978346b8-8564-4f4b-aa91-3b2b8e74482c
@contentRevision = replace-with-default-currentRevision

### Discover published settings; copy default.currentRevision above
GET {{baseUrl}}/api/v1/content/settings

### Start a deterministic run
POST {{baseUrl}}/api/v1/runs
Content-Type: application/json

{
  "settingId": "default",
  "contentRevision": "{{contentRevision}}",
  "modeId": "standard",
  "runDefinitionId": "default_run",
  "playerEntityId": "player",
  "seed": 424242,
  "commandId": "{{creationCommandId}}"
}

### Read authoritative state
GET {{baseUrl}}/api/v1/runs/{{runId}}

### Ask the server which commands are legal
GET {{baseUrl}}/api/v1/runs/{{runId}}/available-commands

### Execute one idempotent run command
POST {{baseUrl}}/api/v1/runs/{{runId}}/commands
Content-Type: application/json

{
  "commandId": "{{commandId}}",
  "expectedSequence": 1,
  "expectedStep": 1,
  "type": "INVOKE_CARD_ZONE_GAMEPLAY_FLOW",
  "payload": { "flowId": "run.draw", "requestedCount": 1 }
}
