    "startNodeId": "node_0",
    "nodes": [
      {
        "nodeId": "node_0",
        "speaker": {
          "text": "Eco da Runa",
          "translations": {
            "pt_BR": "Eco da Runa"
          }
        },
        "text": {
          "text": "Em Alisyum, todo poder exige um pagamento que você não escolheu pagar. Ajuste seu Mod de Identidade e seus equipamentos antes de entrar em combate.",
          "translations": {
            "pt_BR": "Em Alisyum, todo poder exige um pagamento que você não escolheu pagar. Ajuste seu Mod de Identidade e seus equipamentos antes de entrar em combate."
