{
  "buckets": [
    {
      "bucketId": "base_damage",
      "order": 1,
      "operations": [
        {
          "type": "ADD_FLAT",
          "source": "modifier:weapon_damage"
        },
        {
          "type": "ADD_FLAT",
          "source": "modifier:added_physical_damage"
        }
      ]
    },
    {
      "bucketId": "increased_damage",
      "order": 2,
      "operations": [
        {
          "type": "MULTIPLY",
          "source": "formula:1 + (modifier:increased_damage / 100)"
        }
      ]
    },
    {
      "bucketId": "more_damage",
      "order": 3,
      "operations": [
        {
          "type": "MULTIPLY",
          "source": "formula:1 + (modifier:more_damage / 100)"
        }
      ]
    },
    {
      "bucketId": "crit_roll",
      "order": 4,
      "operations": [
        {
          "type": "ROLL_CRIT_TIER",
          "source": "modifier:crit_chance"
        }
      ]
    },
    {
      "bucketId": "crit_multiplier",
      "order": 5,
      "filterConditions": [
        {
          "type": "METADATA_EXISTS",
          "parameter": "crit_tier"
        }
      ],
      "operations": [
        {
          "type": "MULTIPLY",
          "source": "modifier:crit_multiplier"
        }
      ]
    },
    {
      "bucketId": "armor_reduction",
      "order": 6,
      "filterConditions": [
        {
          "type": "TAG_PRESENT",
          "parameter": "physical"
        }
      ],
      "operations": [
        {
          "type": "MULTIPLY",
          "source": "formula:1 - (modifier:target_armor / (modifier:target_armor + 10 * current_damage))"
        }
      ]
    },
    {
      "bucketId": "resistance",
      "order": 7,
      "operations": [
        {
          "type": "MULTIPLY",
          "source": "formula:1 - (modifier:target_resistance / 100)"
        }
      ]
    }
  ]
}
