[gd_scene format=3]

[node name="ActivityHeader" type="VBoxContainer"]
theme_override_constants/separation = 8

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Titles" type="VBoxContainer" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="RunTitle" type="Label" parent="Row/Titles"]
layout_mode = 2
tooltip_text = "Seed: 0 · Sequence: 0"
theme_type_variation = &"ScreenTitle"
theme_override_colors/font_color = Color(0.1254902, 0.12941177, 0.14117648, 1)
theme_override_font_sizes/font_size = 30
text = "THE EMBER PATH"
metadata/font_role = "screen_title"
metadata/text_role = "text.primary"

[node name="Subtitle" type="Label" parent="Row/Titles"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Caption"
theme_override_font_sizes/font_size = 14
text = "Build your deck. Choose your path."
autowrap_mode = 3
metadata/font_role = "caption"

[node name="Verify" type="Button" parent="Row"]
custom_minimum_size = Vector2(185, 48)
layout_mode = 2
theme_type_variation = &"SecondaryAction"
text = "VERIFY REPLAY"

[node name="Map" type="Button" parent="Row"]
custom_minimum_size = Vector2(100, 48)
layout_mode = 2
theme_type_variation = &"SecondaryAction"
text = "MAP"

[node name="Loadout" type="Button" parent="Row"]
custom_minimum_size = Vector2(140, 48)
layout_mode = 2
theme_type_variation = &"SecondaryAction"
text = "LOADOUT"

[node name="Pause" type="Button" parent="Row"]
custom_minimum_size = Vector2(100, 48)
layout_mode = 2
theme_type_variation = &"SecondaryAction"
text = "PAUSE"

[node name="Badges" type="HFlowContainer" parent="."]
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 6
alignment = 2
