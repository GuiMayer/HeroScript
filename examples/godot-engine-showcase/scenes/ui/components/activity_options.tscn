[gd_scene format=3]
[ext_resource type="Script" path="res://scripts/ui/components/activity_options_view.gd" id="Script"]
[node name="ActivityOptions" type="VBoxContainer"]
script = ExtResource("Script")
[node name="ActionPanel" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14
[node name="Waiting" type="VBoxContainer" parent="ActionPanel"]
layout_mode = 2
[node name="Message" type="Label" parent="ActionPanel/Waiting"]
layout_mode = 2
theme_type_variation = &"Caption"
theme_override_font_sizes/font_size = 15
autowrap_mode = 3
text = "Waiting for the next available action."
[node name="RefreshActionsButton" type="Button" parent="ActionPanel/Waiting"]
layout_mode = 2
custom_minimum_size = Vector2(0,48)
theme_type_variation = &"SecondaryAction"
text = "REFRESH ACTIONS"
metadata/activity_choice = true
[node name="Primary" type="HFlowContainer" parent="ActionPanel"]
layout_mode = 2
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 14
[node name="SecondaryTitle" type="Label" parent="ActionPanel"]
layout_mode = 2
theme_type_variation = &"Caption"
theme_override_font_sizes/font_size = 13
autowrap_mode = 3
text = "OTHER OPTIONS"
[node name="Secondary" type="VBoxContainer" parent="ActionPanel"]
layout_mode = 2
theme_override_constants/separation = 8
