{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:5173"
  ],
  "Admin": {
    "Enabled": false
  },
  "AllowConfigReload": false,
  "Combat": {
    "TurnOrderStrategy": "FIXED"
  },
  "Persistence": {
    "EventStorePath": "data/events",
    "RunStatePath": "data/runs",
    "ContentStorePath": "data/content",
    "Snapshots": {
      "MaxRetainedSnapshots": 100,
      "CreateSnapshotOn": [
        "TurnEnd",
        "OutOfCombatEffect"
      ]
    }
  }
}
