{
  "openapi": "3.0.4",
  "info": {
    "title": "HeroScript API",
    "version": "v1",
    "description": "Contrato público para runs determinísticas, conteúdo imutável e replay verificável. Toda resposta não bem-sucedida usa RFC 9457 Problem Details."
  },
  "servers": [
    { "url": "http://localhost:5260", "description": "Desenvolvimento local" }
  ],
  "tags": [
    { "name": "System" },
    { "name": "Runs" },
    { "name": "Combats" },
    { "name": "Content" },
    { "name": "Sandbox" }
  ],
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "tags": ["System"],
        "operationId": "getLiveness",
        "x-heroscript-stability": "stable",
        "responses": { "200": { "description": "Process is alive" } }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "tags": ["System"],
        "operationId": "getReadiness",
        "x-heroscript-stability": "stable",
        "responses": { "200": { "description": "Content and durable run store are ready" } }
      }
    },
    "/api/v1/version": {
      "get": {
        "tags": ["System"],
        "operationId": "getVersion",
        "x-heroscript-stability": "stable",
        "responses": { "200": { "description": "API and deterministic engine version" } }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "tags": ["System"],
        "operationId": "getCapabilities",
        "x-heroscript-stability": "stable",
        "responses": { "200": { "description": "Published capability list" } }
      }
    },
    "/api/v1/runs": {
      "get": {
        "tags": ["Runs"],
        "operationId": "listRuns",
        "x-heroscript-stability": "stable",
        "responses": { "200": { "description": "Persisted run summaries" } }
      },
      "post": {
        "tags": ["Runs"],
        "operationId": "startRun",
        "x-heroscript-stability": "stable",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunStartRequest" } } }
        },
        "responses": {
          "200": { "description": "Run created deterministically" },
          "400": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/runs/{runId}": {
      "get": {
        "tags": ["Runs"],
        "operationId": "getRun",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": {
          "200": { "description": "Immutable run read model" },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/runs/{runId}/commands": {
      "post": {
        "tags": ["Runs"],
        "operationId": "executeRunCommand",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommandEnvelope" } } }
        },
        "responses": {
          "200": { "description": "Idempotent command result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommandResult" } } } },
          "409": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/combats/{combatId}": {
      "get": {
        "tags": ["Combats"],
        "operationId": "getCombat",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/CombatId" }],
        "responses": { "200": { "description": "Combat read model" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/combats/{combatId}/commands": {
      "post": {
        "tags": ["Combats"],
        "operationId": "executeCombatCommand",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/CombatId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommandEnvelope" } } }
        },
        "responses": {
          "200": { "description": "Idempotent command result with durable animation resolution", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CombatCommandResult" } } } },
          "409": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/combats/{combatId}/resolutions/{commandId}": {
      "get": {
        "tags": ["Combats"],
        "operationId": "getCombatResolution",
        "x-heroscript-stability": "stable",
        "parameters": [
          { "$ref": "#/components/parameters/CombatId" },
          { "name": "commandId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Durable ordered animation frames produced by one accepted combat command", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CombatResolutionRecord" } } } },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/content/revisions": {
      "get": {
        "tags": ["Content"],
        "operationId": "listContentRevisions",
        "x-heroscript-stability": "stable",
        "responses": { "200": { "description": "Immutable content revision catalog" } }
      }
    },
    "/api/v1/content/revisions/{revision}": {
      "get": {
        "tags": ["Content"],
        "operationId": "getContentRevision",
        "x-heroscript-stability": "stable",
        "parameters": [{ "name": "revision", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Immutable content manifest" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/content/{kind}": {
      "get": {
        "tags": ["Content"],
        "operationId": "listContentDefinitions",
        "x-heroscript-stability": "stable",
        "parameters": [{ "name": "kind", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "revision", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Definitions from one immutable revision" } }
      }
    },
    "/api/v1/content/{kind}/{definitionId}": {
      "get": {
        "tags": ["Content"],
        "operationId": "getContentDefinition",
        "x-heroscript-stability": "stable",
        "parameters": [{ "name": "kind", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "definitionId", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "revision", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "One definition from an immutable revision" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/profiles/{playerId}": {
      "get": {
        "tags": ["System"],
        "operationId": "getProfileProjection",
        "x-heroscript-stability": "experimental",
        "parameters": [{ "name": "playerId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Derived immutable player profile projection" } }
      }
    },
    "/api/v1/challenges/daily/current": {
      "get": {
        "tags": ["System"],
        "operationId": "getCurrentDailyChallenge",
        "x-heroscript-stability": "experimental",
        "responses": { "200": { "description": "Daily seed, content revision and proof hash" } }
      }
    },
    "/api/v1/simulations": {
      "post": {
        "tags": ["Runs"],
        "operationId": "createSimulation",
        "x-heroscript-stability": "experimental",
        "responses": { "200": { "description": "Isolated deterministic simulation" }, "422": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/simulations/{simulationId}": {
      "get": {
        "tags": ["Runs"],
        "operationId": "getSimulation",
        "x-heroscript-stability": "experimental",
        "parameters": [{ "name": "simulationId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Simulation status, deterministic result hash and compact command timeline" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/simulations/{simulationId}/result": {
      "get": {
        "tags": ["Runs"],
        "operationId": "getSimulationResult",
        "x-heroscript-stability": "experimental",
        "parameters": [{ "name": "simulationId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Complete immutable simulation result" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/admin/content/drafts": {
      "post": {
        "tags": ["Content"],
        "operationId": "createContentDraft",
        "x-heroscript-stability": "admin",
        "security": [{ "AdminApiKey": [] }],
        "responses": { "201": { "description": "Mutable publication draft created" }, "422": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/runs/{runId}/available-commands": {
      "get": {
        "tags": ["Runs"],
        "operationId": "getAvailableRunCommands",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": { "200": { "description": "Commands allowed by the pinned immutable state" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/runs/{runId}/map": {
      "get": {
        "tags": ["Runs"],
        "operationId": "getRunMap",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": { "200": { "description": "Pinned map and progression read model" } }
      }
    },
    "/api/v1/runs/{runId}/journal": {
      "get": {
        "tags": ["Runs"],
        "operationId": "getRunJournal",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": { "200": { "description": "Durable, ordered command journal" } }
      }
    },
    "/api/v1/runs/{runId}/checkpoints": {
      "get": {
        "tags": ["Runs"],
        "operationId": "getRunCheckpoints",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": { "200": { "description": "Durable checkpoint metadata" } }
      }
    },
    "/api/v1/runs/{runId}/checkpoints/{sequence}": {
      "get": {
        "tags": ["Runs"],
        "operationId": "getRunCheckpoint",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "name": "sequence", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }],
        "responses": { "200": { "description": "Immutable run checkpoint" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/runs/{runId}/timeline": {
      "get": {
        "tags": ["Runs"],
        "operationId": "getRunTimeline",
        "x-heroscript-stability": "experimental",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": { "200": { "description": "Run command timeline projection" } }
      }
    },
    "/api/v1/runs/{runId}/branches": {
      "get": {
        "tags": ["Runs"],
        "operationId": "listRunBranches",
        "x-heroscript-stability": "experimental",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": { "200": { "description": "Direct deterministic child branches" } }
      },
      "post": {
        "tags": ["Runs"],
        "operationId": "createRunBranch",
        "x-heroscript-stability": "experimental",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": { "200": { "description": "A deterministic branch from one historical sequence" }, "422": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/runs/{runId}/branch-tree": {
      "get": {
        "tags": ["Runs"],
        "operationId": "getRunBranchTree",
        "x-heroscript-stability": "experimental",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": { "200": { "description": "Immutable root-to-descendant run branch tree" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/runs/{runId}/verify": {
      "post": {
        "tags": ["Runs"],
        "operationId": "verifyRunReplay",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": { "200": { "description": "Semantic replay verification result" } }
      }
    },
    "/api/v1/combats/{combatId}/cards/{cardInstanceId}/evaluation": {
      "get": {
        "tags": ["Combats"],
        "operationId": "evaluateCombatCard",
        "x-heroscript-stability": "experimental",
        "parameters": [
          { "$ref": "#/components/parameters/CombatId" },
          { "name": "cardInstanceId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "actorId", "in": "query", "schema": { "type": "string" } },
          { "name": "targetIds", "in": "query", "schema": { "type": "array", "items": { "type": "string" } } },
          { "name": "costOptionId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Pinned card container, legal-play evaluation and deterministic resolution preview", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CardInspectionResult" } } } },
          "400": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/combats/{combatId}/cards/evaluations": {
      "get": {
        "tags": ["Combats"],
        "operationId": "evaluateCombatHand",
        "x-heroscript-stability": "experimental",
        "parameters": [
          { "$ref": "#/components/parameters/CombatId" },
          { "name": "actorId", "in": "query", "schema": { "type": "string" } },
          { "name": "targetIds", "in": "query", "schema": { "type": "array", "items": { "type": "string" } } },
          { "name": "costOptionId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "One card evaluation for every hand instance", "content": { "application/json": { "schema": { "type": "object", "properties": { "combatId": { "type": "string", "format": "uuid" }, "cards": { "type": "array", "items": { "$ref": "#/components/schemas/CardInspectionResult" } } } } } } },
          "400": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/combats/{combatId}/history": {
      "get": {
        "tags": ["Combats"],
        "operationId": "getCombatHistory",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/CombatId" }],
        "responses": { "200": { "description": "Resolved combat action history" } }
      }
    },
    "/api/v1/combats/{combatId}/journal": {
      "get": {
        "tags": ["Combats"],
        "operationId": "getCombatJournal",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/CombatId" }],
        "responses": { "200": { "description": "Combat commands filtered from the durable run journal" } }
      }
    },
    "/api/v1/combats/{combatId}/timeline": {
      "get": {
        "tags": ["Combats"],
        "operationId": "getCombatTimeline",
        "x-heroscript-stability": "experimental",
        "parameters": [{ "$ref": "#/components/parameters/CombatId" }, { "name": "afterSequence", "in": "query", "schema": { "type": "integer", "minimum": 0 } }, { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1 } }],
        "responses": {
          "200": {
            "description": "Policy-governed combat command timeline and turn groups",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CombatTimelinePage" } } }
          },
          "422": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/combats/{combatId}/timeline/{sequence}/state": {
      "get": {
        "tags": ["Combats"],
        "operationId": "getHistoricalCombatTimelineState",
        "x-heroscript-stability": "experimental",
        "parameters": [{ "$ref": "#/components/parameters/CombatId" }, { "name": "sequence", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }],
        "responses": { "200": { "description": "Immutable historical state selected by a combat timeline item" }, "422": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/combats/{combatId}/timeline/{sequence}/branches": {
      "post": {
        "tags": ["Combats"],
        "operationId": "createCombatTimelineBranch",
        "x-heroscript-stability": "experimental",
        "parameters": [{ "$ref": "#/components/parameters/CombatId" }, { "name": "sequence", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }],
        "responses": { "200": { "description": "Independent child run and combat anchored at a historical combat state" }, "422": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/combats/{combatId}/verify": {
      "post": {
        "tags": ["Combats"],
        "operationId": "verifyCombatReplay",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/CombatId" }],
        "responses": { "200": { "description": "Combat projection verified against run semantic replay" } }
      }
    },
    "/api/v1/runs/{runId}/events": {
      "get": {
        "tags": ["Runs"],
        "operationId": "getRunEvents",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "name": "afterSequence", "in": "query", "schema": { "type": "integer", "minimum": 0 } }],
        "responses": { "200": { "description": "Durable event projection page" } }
      }
    },
    "/api/v1/runs/{runId}/events/stream": {
      "get": {
        "tags": ["Runs"],
        "operationId": "streamRunEvents",
        "x-heroscript-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "name": "afterSequence", "in": "query", "schema": { "type": "integer", "minimum": 0 } }],
        "responses": { "200": { "description": "SSE stream; see AsyncAPI contract", "content": { "text/event-stream": { "schema": { "type": "string" } } } } }
      }
    },
    "/api/v1/sandbox/scenarios/validate": {
      "post": {
        "tags": ["Sandbox"],
        "operationId": "validateCombatScenario",
        "x-heroscript-stability": "experimental",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CombatScenarioDefinition" } } } },
        "responses": { "200": { "description": "Normalized, validated scenario and deterministic scenario hash" }, "422": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/sandbox/runs": {
      "post": {
        "tags": ["Sandbox"],
        "operationId": "launchCombatScenario",
        "x-heroscript-stability": "experimental",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CombatScenarioDefinition" } } } },
        "responses": { "200": { "description": "Idempotent scenario run and active combat launch" }, "422": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/sandbox/runs/{runId}/scenario": {
      "get": {
        "tags": ["Sandbox"],
        "operationId": "getCombatScenario",
        "x-heroscript-stability": "experimental",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": { "200": { "description": "Persisted normalized scenario input" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/sandbox/runs/{runId}/snapshot": {
      "get": {
        "tags": ["Sandbox"],
        "operationId": "getCombatSandboxSnapshot",
        "x-heroscript-stability": "experimental",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": { "200": { "description": "Consolidated read-only run, combat, actor and card-instance projection" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    }
  },
  "components": {
    "parameters": {
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "CombatId": { "name": "combatId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "responses": {
      "Problem": {
        "description": "RFC 9457 problem response",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      }
    },
    "securitySchemes": {
      "AdminApiKey": { "type": "apiKey", "in": "header", "name": "X-Admin-Key" }
    },
    "schemas": {
      "RunStartRequest": {
        "type": "object",
        "required": ["configName", "runDefinitionId", "playerEntityId"],
        "properties": {
          "configName": { "type": "string" },
          "runDefinitionId": { "type": "string" },
          "playerEntityId": { "type": "string" },
          "seed": { "type": "integer", "format": "uint64" },
          "contentRevision": { "type": "string" },
          "modeId": { "type": "string", "default": "standard", "description": "Published game mode; omitted selects the canonical standard mode." }
        }
      },
      "CombatScenarioDefinition": {
        "type": "object",
        "required": ["schemaVersion", "modeId", "seed", "attemptKey", "participants", "deck"],
        "properties": {
          "schemaVersion": { "type": "integer", "const": 2 },
          "modeId": { "type": "string" },
          "contentRevision": { "type": "string", "description": "Published content revision; omitted means the current revision." },
          "seed": { "type": "integer", "format": "uint64" },
          "attemptKey": { "type": "string", "description": "Changes the deterministic identity of a new attempt." },
          "participants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["instanceId", "entityDefinitionId", "sideId", "controllerBinding"],
              "properties": {
                "instanceId": { "type": "string" },
                "entityDefinitionId": { "type": "string" },
                "sideId": { "type": "string" },
                "controllerBinding": {
                  "type": "object",
                  "required": ["kind"],
                  "properties": {
                    "kind": { "type": "string", "enum": ["Player", "AI", "None"] },
                    "policyId": { "type": ["string", "null"] }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "deck": { "type": "array", "items": { "type": "object" } },
          "initialState": { "type": "object" }
        }
      },
      "CommandEnvelope": {
        "type": "object",
        "required": ["commandId", "type", "payload"],
        "properties": {
          "commandId": { "type": "string", "format": "uuid", "description": "Idempotency key" },
          "expectedSequence": { "type": "integer", "minimum": 0 },
          "expectedStep": { "type": "integer", "format": "uint64" },
          "type": {
            "type": "string",
            "description": "Canonical command type. ACTIVATE_CONTENT_REVISION accepts { revision } and is allowed only when the run's resolved GameMode enables versioned activation."
          },
          "payload": { "type": "object", "additionalProperties": true }
        }
      },
      "CommandResult": {
        "type": "object",
        "required": ["commandId", "step", "previousStateHash", "stateHash", "state", "events"],
        "properties": {
          "commandId": { "type": "string", "format": "uuid" },
          "sequence": { "type": "integer" },
          "step": { "type": "integer", "format": "uint64" },
          "previousStateHash": { "type": "string" },
          "stateHash": { "type": "string" },
          "state": { "type": "object", "additionalProperties": true },
          "events": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        }
      },
      "CombatCommandResult": {
        "allOf": [
          { "$ref": "#/components/schemas/CommandResult" },
          {
            "type": "object",
            "properties": {
              "state": { "$ref": "#/components/schemas/CombatCommandState" }
            }
          }
        ]
      },
      "CombatCommandState": {
        "type": "object",
        "required": ["run", "combat", "resolution"],
        "properties": {
          "run": { "type": "object", "additionalProperties": true },
          "combat": { "type": "object", "nullable": true, "additionalProperties": true },
          "resolution": { "$ref": "#/components/schemas/CombatResolutionRecord" }
        }
      },
      "CombatResolutionRecord": {
        "type": "object",
        "required": ["commandId", "combatId", "commandType", "mode", "firstSequence", "finalSequence", "initialCombatStateHash", "finalCombatStateHash", "resolutionFingerprint", "frames"],
        "properties": {
          "commandId": { "type": "string", "format": "uuid" },
          "combatId": { "type": "string", "format": "uuid" },
          "commandType": { "type": "string" },
          "mode": { "type": "string", "enum": ["FullSnapshots", "CompactWithSnapshotLookup"] },
          "firstSequence": { "type": "integer", "minimum": 1 },
          "finalSequence": { "type": "integer", "minimum": 1 },
          "initialCombatStateHash": { "type": "string", "minLength": 64, "maxLength": 64 },
          "finalCombatStateHash": { "type": "string", "minLength": 64, "maxLength": 64 },
          "resolutionFingerprint": { "type": "string", "minLength": 64, "maxLength": 64 },
          "frames": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CombatAnimationFrame" }
          }
        }
      },
      "CombatAnimationFrame": {
        "type": "object",
        "required": ["frameId", "index", "runSequence", "combatStep", "transitionType", "payload", "effectSteps", "calculations", "applications", "snapshotSequence"],
        "properties": {
          "frameId": { "type": "string", "format": "uuid" },
          "index": { "type": "integer", "minimum": 0 },
          "runSequence": { "type": "integer", "minimum": 1 },
          "combatStep": { "type": "integer", "format": "uint64" },
          "transitionType": { "type": "string" },
          "payload": { "type": "object", "additionalProperties": true },
          "effectSteps": {
            "type": "array",
            "description": "Ordered, source-independent effect execution trace.",
            "items": { "$ref": "#/components/schemas/EffectExecutionStep" }
          },
          "calculations": {
            "type": "array",
            "description": "Bucket calculations used by effects in this frame.",
            "items": { "$ref": "#/components/schemas/CalculationTrace" }
          },
          "applications": {
            "type": "array",
            "description": "Concrete immutable mutations produced by the frame.",
            "items": { "$ref": "#/components/schemas/EffectApplicationRecord" }
          },
          "stateAfter": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "Present in FullSnapshots mode; null in compact mode."
          },
          "snapshotSequence": {
            "type": "integer",
            "minimum": 1,
            "description": "Sequence accepted by GET /timeline/{sequence}/state for compact frame lookup."
          }
        }
      },
      "EffectExecutionStep": {
        "type": "object",
        "required": ["index", "effectInstanceId", "targetEntityId", "repeatIndex", "targetIndex", "applied", "contentRevision", "provenance", "applications", "stateBeforeHash", "stateAfterHash"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "effectInstanceId": { "type": "string" },
          "targetEntityId": { "type": "string" },
          "repeatIndex": { "type": "integer", "minimum": 0 },
          "targetIndex": { "type": "integer", "minimum": 0 },
          "applied": { "type": "boolean" },
          "skipReason": { "type": "string", "nullable": true },
          "chanceRoll": { "type": "number", "nullable": true },
          "contentRevision": { "type": "string" },
          "provenance": { "type": "object", "additionalProperties": true },
          "calculation": { "allOf": [{ "$ref": "#/components/schemas/CalculationTrace" }], "nullable": true },
          "applications": { "type": "array", "items": { "$ref": "#/components/schemas/EffectApplicationRecord" } },
          "stateBeforeHash": { "type": "string" },
          "stateAfterHash": { "type": "string" },
          "runBeforeHash": { "type": "string", "nullable": true },
          "runAfterHash": { "type": "string", "nullable": true }
        }
      },
      "CalculationTrace": {
        "type": "object",
        "description": "Resolved calculation including ordered buckets, contributions and provenance.",
        "additionalProperties": true
      },
      "EffectApplicationRecord": {
        "type": "object",
        "required": ["effectInstanceId", "effectType", "targetEntityId", "provenance"],
        "properties": {
          "effectInstanceId": { "type": "string" },
          "effectType": { "type": "string" },
          "targetEntityId": { "type": "string" },
          "resourceId": { "type": "string", "nullable": true },
          "resourceField": { "type": "string", "nullable": true },
          "resourceOperation": { "type": "string", "nullable": true },
          "previousValue": { "type": "number", "nullable": true },
          "currentValue": { "type": "number", "nullable": true },
          "statusId": { "type": "string", "nullable": true },
          "statusInstanceId": { "type": "string", "format": "uuid", "nullable": true },
          "removedStatusInstanceIds": { "type": "array", "items": { "type": "string", "format": "uuid" } },
          "cardInstanceIds": { "type": "array", "items": { "type": "string", "format": "uuid" } },
          "modifierInstanceId": { "type": "string", "format": "uuid", "nullable": true },
          "modifierId": { "type": "string", "nullable": true },
          "removedModifierInstanceIds": {
            "type": "array",
            "description": "All modifier instances removed by this application, in deterministic order.",
            "items": { "type": "string", "format": "uuid" }
          },
          "modifierStackChanges": {
            "type": "array",
            "description": "Complete before/after stack trace for every affected modifier instance.",
            "items": { "$ref": "#/components/schemas/ModifierStackApplicationRecord" }
          },
          "provenance": { "type": "object", "additionalProperties": true }
        }
      },
      "ModifierStackApplicationRecord": {
        "type": "object",
        "required": ["modifierInstanceId", "modifierId", "previousStacks", "currentStacks", "removed"],
        "properties": {
          "modifierInstanceId": { "type": "string", "format": "uuid" },
          "modifierId": { "type": "string" },
          "previousStacks": { "type": "integer", "minimum": 0 },
          "currentStacks": { "type": "integer", "minimum": 0 },
          "removed": { "type": "boolean" }
        }
      },
      "CombatTimelineItem": {
        "type": "object",
        "required": ["runSequence", "combatStep", "turn", "commandType", "previousStateHash", "stateHash", "snapshotAvailable", "summary"],
        "properties": {
          "runSequence": { "type": "integer", "minimum": 1 },
          "combatStep": { "type": "integer", "format": "uint64" },
          "turn": { "type": "integer", "minimum": 0 },
          "phase": { "type": "string", "nullable": true },
          "actorId": { "type": "string", "nullable": true },
          "commandType": { "type": "string" },
          "commandId": { "type": "string", "format": "uuid", "nullable": true },
          "rootCommandId": { "type": "string", "format": "uuid", "nullable": true },
          "resolutionCommandId": { "type": "string", "format": "uuid", "nullable": true, "description": "Use with GET /resolutions/{commandId}; null when the item has no visual resolution." },
          "resolutionFingerprint": { "type": "string", "nullable": true },
          "previousStateHash": { "type": "string" },
          "stateHash": { "type": "string" },
          "snapshotAvailable": { "type": "boolean" },
          "summary": { "type": "object", "additionalProperties": true }
        }
      },
      "CombatTimelinePage": {
        "type": "object",
        "required": ["runId", "combatId", "afterSequence", "nextCursor", "items", "turnGroups"],
        "properties": {
          "runId": { "type": "string", "format": "uuid" },
          "combatId": { "type": "string", "format": "uuid" },
          "afterSequence": { "type": "integer", "minimum": 0 },
          "nextCursor": { "type": "integer", "minimum": 0 },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/CombatTimelineItem" } },
          "turnGroups": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["turn", "items"],
              "properties": {
                "turn": { "type": "integer", "minimum": 0 },
                "items": { "type": "array", "items": { "$ref": "#/components/schemas/CombatTimelineItem" } }
              }
            }
          }
        }
      },
      "CardInspectionResult": {
        "type": "object",
        "required": ["version", "detail", "zone", "isInHand", "isPlayable", "baseContainer", "compiledContainer", "appliedUpgrades", "effectiveBase", "evaluation", "calculations", "previewSteps", "previewApplications", "disposition", "resolutionFingerprint"],
        "properties": {
          "version": { "type": "object", "description": "Run, combat, engine and content-revision coordinates used by this projection", "additionalProperties": true },
          "detail": { "type": "string", "enum": ["Resolved", "Full"] },
          "zone": { "type": "string", "enum": ["hand", "draw", "discard", "exhaust", "collection"] },
          "isInHand": { "type": "boolean" },
          "isPlayable": { "type": "boolean", "description": "Includes card conditions, costs, targeting, active actor, phase and action budget." },
          "baseContainer": { "type": "object", "additionalProperties": true },
          "compiledContainer": { "type": "object", "additionalProperties": true },
          "appliedUpgrades": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "effectiveBase": { "type": "object", "additionalProperties": true },
          "contextSources": { "type": "object", "nullable": true, "description": "Pinned actor, targets, statuses, relics, modifiers and mode policies; present only at Full detail.", "additionalProperties": true },
          "evaluation": { "type": "object", "additionalProperties": true },
          "calculations": { "type": "array", "description": "Configured bucket traces and influence provenance", "items": { "type": "object", "additionalProperties": true } },
          "previewSteps": { "type": "array", "description": "Ordered effect trace produced by the same pure transaction used by PLAY_CARD", "items": { "$ref": "#/components/schemas/EffectExecutionStep" } },
          "previewApplications": { "type": "array", "description": "Exact immutable effect preview from the current deterministic snapshot", "items": { "type": "object", "additionalProperties": true } },
          "disposition": { "type": "string" },
          "resolutionFingerprint": { "type": "string" }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "required": ["type", "title", "status", "detail", "instance", "code", "correlationId"],
        "properties": {
          "type": { "type": "string", "format": "uri-reference" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string", "format": "uri-reference" },
          "code": { "type": "string", "description": "Stable machine-readable HeroScript error code" },
          "correlationId": { "type": "string", "description": "Request correlation identifier" },
          "currentSequence": { "type": "integer", "description": "Authoritative sequence when a command conflicts" },
          "currentStep": { "type": "integer", "format": "uint64", "description": "Authoritative deterministic step when a command conflicts" }
        }
      }
    }
  }
}
