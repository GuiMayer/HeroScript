theme_type_variation = &"Caption"
theme_override_font_sizes/font_size = 14
metadata/font_role = "caption"
autowrap_mode = 3

[node name="PrintedIdentity" type="VBoxContainer" parent="CardDetailsScroll/CardDetailContent/Classic"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="DetailTitle" type="Label" parent="CardDetailsScroll/CardDetailContent/Classic/PrintedIdentity"]
