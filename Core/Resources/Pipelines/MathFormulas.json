{
  "HYPERBOLIC_CURVE": {
    "description": "Hyperbolic curve for diminishing returns (e.g., armor)",
    "params": {
      "SCALING_VALUE": 100
    },
    "operations": [
      { "op": "ADD", "operands": ["$input", "params.SCALING_VALUE"] },
      { "op": "DIVIDE", "operands": ["params.SCALING_VALUE", "$result"] }
    ]
  },

  "LINEAR_ADDITIVE": {
    "description": "Linear additive sum - base function for damage + flat attributes",
    "params": {
      "FLAT_BONUS": 10
    },
    "operations": [
      { "op": "ADD", "operands": ["$input", "params.FLAT_BONUS"] }
    ]
  },

  "MULTIPLICATIVE_BUFF": {
    "description": "Percentage multiplier for buffs/debuffs",
    "params": {
      "MULTIPLIER": 1.5
    },
    "operations": [
      { "op": "MULTIPLY", "operands": ["$input", "params.MULTIPLIER"] }
    ]
  },

  "EXPONENTIAL_SCALING": {
    "description": "Exponential scaling for snowball mechanics",
    "params": {
      "BASE": 2,
      "EXPONENT": 2
    },
    "operations": [
      { "op": "MULTIPLY", "operands": ["$input", "params.BASE"] },
      { "op": "POW", "operands": ["$result", "params.EXPONENT"] }
    ]
  },

  "LOGARITHMIC_SCALING": {
    "description": "Logarithmic scaling for bonuses with diminishing returns",
    "params": {
      "SCALE_FACTOR": 10
    },
    "operations": [
      { "op": "LOG", "operands": ["$input"] },
      { "op": "MULTIPLY", "operands": ["$result", "params.SCALE_FACTOR"] }
    ]
  },

  "SIGMOID_CURVE": {
    "description": "Sigmoid curve (S-curve) for hit chance or status effects",
    "params": {
      "MIDPOINT": 50,
      "STEEPNESS": 0.1,
      "MAX_VALUE": 100
    },
    "operations": [
      { "op": "SUBTRACT", "operands": ["$input", "params.MIDPOINT"] },
      { "op": "MULTIPLY", "operands": ["$result", "params.STEEPNESS"] },
      { "op": "MULTIPLY", "operands": ["$result", -1] },
      { "op": "POW", "operands": [2.718281828, "$result"] },
      { "op": "ADD", "operands": ["$result", 1] },
      { "op": "DIVIDE", "operands": ["params.MAX_VALUE", "$result"] }
    ]
  },

  "CLAMP_SATURATION": {
    "description": "Saturation with minimum and maximum limits",
    "params": {
      "MIN_VALUE": 0,
      "MAX_VALUE": 999
    },
    "operations": [
      { "op": "CLAMP", "operands": ["$input", "params.MIN_VALUE", "params.MAX_VALUE"] }
    ]
  },

  "LIFE_STEAL_CONVERSION": {
    "description": "Delta conversion for life steal (fraction of damage as healing)",
    "params": {
      "STEAL_PERCENTAGE": 0.2
    },
    "operations": [
      { "op": "MULTIPLY", "operands": ["$input", "params.STEAL_PERCENTAGE"] }
    ]
  },

  "REFLECT_DAMAGE": {
    "description": "Damage reflection (fraction of damage received returns to attacker)",
    "params": {
      "REFLECT_PERCENTAGE": 0.15
    },
    "operations": [
      { "op": "MULTIPLY", "operands": ["$input", "params.REFLECT_PERCENTAGE"] }
    ]
  },

  "STEP_FUNCTION_MANA": {
    "description": "Step function discretization - gain mana per X damage dealt",
    "params": {
      "DAMAGE_THRESHOLD": 10,
      "MANA_PER_THRESHOLD": 1
    },
    "operations": [
      { "op": "DIVIDE", "operands": ["$input", "params.DAMAGE_THRESHOLD"] },
      { "op": "MULTIPLY", "operands": ["$result", "params.MANA_PER_THRESHOLD"] }
    ]
  },

  "ARMOR_REDUCTION": {
    "description": "Armor-based damage reduction with diminishing returns",
    "params": {
      "ARMOR_SCALING": 100
    },
    "operations": [
      { "op": "DIVIDE", "operands": ["$input", "params.ARMOR_SCALING"] },
      { "op": "ADD", "operands": ["$result", 1] },
      { "op": "DIVIDE", "operands": [1, "$result"] }
    ]
  },

  "PERCENTAGE_BASED_DAMAGE": {
    "description": "Percentage-based damage from base value",
    "params": {
      "BASE_DAMAGE": 100,
      "PERCENTAGE": 0.5
    },
    "operations": [
      { "op": "ADD", "operands": ["$input", "params.BASE_DAMAGE"] },
      { "op": "MULTIPLY", "operands": ["$result", "params.PERCENTAGE"] }
    ]
  },

  "CRITICAL_MULTIPLIER": {
    "description": "Critical damage multiplier with additive bonus",
    "params": {
      "CRIT_MULTIPLIER": 2.0,
      "FLAT_BONUS": 50
    },
    "operations": [
      { "op": "MULTIPLY", "operands": ["$input", "params.CRIT_MULTIPLIER"] },
      { "op": "ADD", "operands": ["$result", "params.FLAT_BONUS"] }
    ]
  },

  "COMPOUND_SCALING": {
    "description": "Compound scaling - multiplicative followed by additive",
    "params": {
      "MULTIPLIER": 1.5,
      "FLAT_BONUS": 25
    },
    "operations": [
      { "op": "MULTIPLY", "operands": ["$input", "params.MULTIPLIER"] },
      { "op": "ADD", "operands": ["$result", "params.FLAT_BONUS"] }
    ]
  },

  "INVERSE_COMPOUND_SCALING": {
    "description": "Inverse compound scaling - additive followed by multiplicative",
    "params": {
      "FLAT_BONUS": 25,
      "MULTIPLIER": 1.5
    },
    "operations": [
      { "op": "ADD", "operands": ["$input", "params.FLAT_BONUS"] },
      { "op": "MULTIPLY", "operands": ["$result", "params.MULTIPLIER"] }
    ]
  },

  "SQUARE_ROOT_SCALING": {
    "description": "Square root scaling for moderate growth",
    "params": {
      "SCALE_FACTOR": 10
    },
    "operations": [
      { "op": "SQRT", "operands": ["$input"] },
      { "op": "MULTIPLY", "operands": ["$result", "params.SCALE_FACTOR"] }
    ]
  },

  "THRESHOLD_BONUS": {
    "description": "Bonus activated only above a threshold",
    "params": {
      "THRESHOLD": 100,
      "BONUS_MULTIPLIER": 1.25
    },
    "operations": [
      { "op": "SUBTRACT", "operands": ["$input", "params.THRESHOLD"] },
      { "op": "CLAMP", "operands": ["$result", 0, 9999] },
      { "op": "MULTIPLY", "operands": ["$result", "params.BONUS_MULTIPLIER"] },
      { "op": "ADD", "operands": ["$result", "params.THRESHOLD"] }
    ]
  }
}
