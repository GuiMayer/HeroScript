            "choiceId": "continue",
            "interactionKind": "Continue",
            "once": true,
            "text": {
              "text": "Avançar",
              "translations": {
                "pt_BR": "Avançar"
              }
            },
            "setFlags": {
              "alisyum.chapter1.started": "true"
            }
          }
        ]
      }
    ]
  },
